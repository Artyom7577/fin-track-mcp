<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.artyomh</groupId>
        <artifactId>fin-track-mcp</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>mockdata</artifactId>
    <name>mockdata</name>
    <description>Deterministic generator of fake Evoca-style statements for tests and demos.</description>

    <properties>
        <!-- A property, not plugin config, so -Dexec.mainClass=...GenerateGoldenSample can override it. -->
        <exec.mainClass>com.artyomh.finance.mockdata.cli.GenerateMockData</exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.artyomh</groupId>
            <artifactId>domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <arguments>
                        <argument>${maven.multiModuleProjectDirectory}</argument>
                    </arguments>
                    <systemProperties>
                        <!-- POI logs through Log4j API; without a provider it prints a startup error to stderr. -->
                        <systemProperty>
                            <key>log4j2.statusLoggerLevel</key>
                            <value>OFF</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
